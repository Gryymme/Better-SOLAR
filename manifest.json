{
  "manifest_version": 2,
  "name": "Better SOLAR",
  "version": "2.3.0",
  "description": "Your SOLAR academic records, organized and available offline. All academic data stays in your browser.",
  "permissions": [
    "storage",
    "alarms",
    "https://solar.feualabang.edu.ph/*",
    "https://feu.instructure.com/*"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "icons": {
    "128": "assets/icon128.png"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'",
  "optional_permissions": [
    "https://*/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Better SOLAR",
    "default_icon": {
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://solar.feualabang.edu.ph/*"
      ],
      "js": [
        "scraper/dom.js",
        "scraper/bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
