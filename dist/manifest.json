{
  "manifest_version": 3,
  "name": "Better SOLAR",
  "version": "1.0.8",
  "minimum_chrome_version": "120",
  "description": "Your SOLAR academic records, organized and available offline. All academic data stays in your browser.",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://solar.feualabang.edu.ph/*",
    "https://feu.instructure.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better SOLAR",
    "default_icon": {
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "128": "assets/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
